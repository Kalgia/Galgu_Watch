<Window x:Class="GalguWatch.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galgu Watch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" Focusable="False">
    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="캘린더 열기" Click="OpenMain_Click"/>
            <MenuItem Header="오버레이 숨기기" Click="HideOverlay_Click"/>
            <Separator/>
            <MenuItem Header="종료" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border x:Name="Root" CornerRadius="10" Background="#E61E293B" Padding="10,6"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnToggle" Style="{StaticResource FlatBtn}" Content="▶" FontSize="15"
                    Click="BtnToggle_Click" ToolTip="시작 / 일시정지"/>
            <Button x:Name="BtnStop" Style="{StaticResource FlatBtn}" Content="⏹" FontSize="15"
                    Click="BtnStop_Click" ToolTip="작업 마무리 — 오늘 작업 끝!" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtTime" Foreground="White" FontSize="15" FontFamily="Consolas"
                       VerticalAlignment="Center" Margin="7,0" Text="0:00"/>
            <Button x:Name="BtnShot" Style="{StaticResource FlatBtn}" Content="📷"
                    Click="BtnShot_Click" ToolTip="전체 화면 캡처"/>
            <Button x:Name="BtnRegion" Style="{StaticResource FlatBtn}" Content="✂"
                    Click="BtnRegion_Click" ToolTip="영역 지정 캡처 — 드래그로 범위 선택"/>
        </StackPanel>
    </Border>
</Window>
